# Database (SQL Server)
DATABASE_SERVER=localhost
DATABASE_NAME=SalesRepairDB
DATABASE_USER=sa
DATABASE_PASSWORD=your_password
DATABASE_PORT=1433
DATABASE_ENCRYPT=false
DATABASE_TRUST_SERVER_CERT=true

# App
PORT=5000
NODE_ENV=development

# Bảo mật: danh sách domain frontend được phép gọi API, phân tách bằng dấu phẩy.
# Để trống khi chạy dev cục bộ (cho phép mọi origin). BẮT BUỘC khai báo cụ thể
# khi triển khai production, vd: ALLOWED_ORIGINS=https://shop.example.com
ALLOWED_ORIGINS=

# Auth
JWT_SECRET=change_this_secret_key
JWT_EXPIRES_IN=8h
